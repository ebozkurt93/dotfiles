#!/usr/bin/env bash

set -euo pipefail

picker="walker"
mode="demo"

usage() {
  cat <<'EOF'
Usage: launcher-spike [--picker walker] [--demo|--windows] [--json]

Prototype a neutral launcher item/action model through Walker.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing command: $1" >&2
    exit 1
  }
}

json=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --picker) picker="$2"; shift 2 ;;
    --demo) mode="demo"; shift ;;
    --windows) mode="windows"; shift ;;
    --json) json=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done

demo_items_json() {
  cat <<'EOF'
[
  {
    "id": "action:power-profile",
    "icon": "power",
    "title": "Toggle Power Profile",
    "subtitle": "Switch balanced <-> power-saver",
    "keywords": ["power", "battery", "profile", "low power", "energy"],
    "actions": [
      {"id": "run", "title": "Toggle", "command": "~/bin/helpers/low-power-mode-toggle.sh"},
      {"id": "copy", "title": "Copy Command", "command": "printf '%s' '~/bin/helpers/low-power-mode-toggle.sh' | wl-copy"}
    ]
  },
  {
    "id": "action:bluetooth-toggle",
    "icon": "bluetooth",
    "title": "Toggle Bluetooth",
    "subtitle": "Use bluetoothctl wrapper",
    "keywords": ["bluetooth", "bt", "headphones", "keyboard", "toggle"],
    "actions": [
      {"id": "run", "title": "Toggle", "command": "~/bin/bt-toggle"},
      {"id": "status", "title": "Show Bluetooth Status", "command": "bluetoothctl show | less"}
    ]
  },
  {
    "id": "project:dotfiles",
    "icon": "folder",
    "title": "dotfiles-nixos",
    "subtitle": "~/personal-repositories/dotfiles-nixos",
    "keywords": ["dotfiles", "nixos", "hyprland", "quickshell", "migration"],
    "actions": [
      {"id": "terminal", "title": "Open Terminal Here", "command": "ghostty --working-directory=$HOME/personal-repositories/dotfiles-nixos"},
      {"id": "files", "title": "Open Files", "command": "xdg-open $HOME/personal-repositories/dotfiles-nixos"},
      {"id": "copy-path", "title": "Copy Path", "command": "printf '%s' '$HOME/personal-repositories/dotfiles-nixos' | wl-copy"}
    ]
  },
  {
    "id": "state:spotify",
    "icon": "media-playback-start",
    "title": "State: Spotify",
    "subtitle": "Toggle state-switcher spotify state",
    "keywords": ["state", "spotify", "music", "tmux", "bar"],
    "actions": [
      {"id": "toggle", "title": "Toggle", "command": "$HOME/Documents/bitbar_plugins/state-switcher.5m toggle spotify"},
      {"id": "toggle-no-hook", "title": "Toggle Without Hook", "command": "$HOME/Documents/bitbar_plugins/state-switcher.5m toggle spotify ignore-event"}
    ]
  },
  {
    "id": "doc:hyprland-lua",
    "icon": "text-x-script",
    "title": "Hyprland Lua Config",
    "subtitle": "~/dotfiles/hyprland/.config/hypr/hyprland.lua",
    "keywords": ["hyprland", "lua", "config", "window manager", "keybinds"],
    "actions": [
      {"id": "edit", "title": "Edit", "command": "ghostty --working-directory=$HOME/dotfiles -e nvim hyprland/.config/hypr/hyprland.lua"},
      {"id": "copy-path", "title": "Copy Path", "command": "printf '%s' '$HOME/dotfiles/hyprland/.config/hypr/hyprland.lua' | wl-copy"}
    ]
  },
  {
    "id": "web:translate",
    "icon": "accessories-dictionary",
    "title": "Translate Text",
    "subtitle": "Placeholder for future translation source",
    "keywords": ["translate", "translation", "turkish", "english", "language"],
    "actions": [
      {"id": "open", "title": "Open Google Translate", "command": "xdg-open https://translate.google.com"},
      {"id": "note", "title": "Show Planned Shape", "command": "notify-send 'Translate' 'Future: prompt text, choose language, copy result'"}
    ]
  }
]
EOF
}

windows_items_json() {
  require_cmd hyprctl
  require_cmd jq

  local clients_json
  clients_json="$(hyprctl clients -j 2>/dev/null || true)"
  if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$clients_json"; then
    echo '[]'
    return
  fi

  jq '
    sort_by(.workspace.id, .class, .title)
    | map(select(.mapped == true))
    | map({
        id: ("window:" + .address),
        icon: "window",
        title: ((.title // "untitled") | gsub("[\t\n]"; " ")),
        subtitle: (((.class // "unknown") | gsub("[\t\n]"; " ")) + " - workspace " + ((.workspace.name // (.workspace.id | tostring)) | tostring)),
        keywords: [
          (.class // "unknown"),
          (.title // "untitled"),
          ("workspace " + ((.workspace.name // (.workspace.id | tostring)) | tostring))
        ],
        actions: [
          {id: "focus", title: "Focus Window", command: ("hyprctl dispatch focuswindow address:" + .address)},
          {id: "close", title: "Close Window", command: ("hyprctl dispatch closewindow address:" + .address)},
          {id: "float", title: "Toggle Floating", command: ("hyprctl dispatch togglefloating address:" + .address)},
          {id: "fullscreen", title: "Toggle Fullscreen", command: ("hyprctl dispatch fullscreen 0")}
        ]
      })
  ' <<<"$clients_json"
}

items_json() {
  case "$mode" in
    demo) demo_items_json ;;
    windows) windows_items_json ;;
    *) echo '[]' ;;
  esac
}

item_rows() {
  jq -r '.[] | [
    .id,
    (.icon // ""),
    (.title // ""),
    (.subtitle // ""),
    ((.keywords // []) | join(" "))
  ] | @tsv'
}

action_rows_for() {
  local id="$1"
  jq -r --arg id "$id" '
    .[] | select(.id == $id) | .actions[]
    | [.id, .title, .command] | @tsv
  '
}

select_row() {
  local title="$1"
  case "$picker" in
    walker)
      require_cmd walker
      walker --dmenu --placeholder "$title"
      ;;
    *)
      echo "unknown picker: $picker" >&2
      exit 1
      ;;
  esac
}

items="$(items_json)"

if [ "$json" = 1 ]; then
  printf '%s\n' "$items"
  exit 0
fi

selected_item="$(
  printf '%s\n' "$items" \
    | item_rows \
    | awk -F '\t' '{ print $3 " | " $4 " | " $5 "\t" $1 }' \
    | select_row "Select item"
)"
[ -n "$selected_item" ] || exit 0
item_id="${selected_item##*$'\t'}"

selected_action="$(
  printf '%s\n' "$items" \
    | action_rows_for "$item_id" \
    | awk -F '\t' '{ print $2 " | " $3 "\t" $1 "\t" $3 }' \
    | select_row "Select action"
)"
[ -n "$selected_action" ] || exit 0

command_to_run="${selected_action##*$'\t'}"
[ -n "$command_to_run" ] || exit 0

sh -lc "$command_to_run"
