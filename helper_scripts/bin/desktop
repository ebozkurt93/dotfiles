#!/usr/bin/env bash
set -euo pipefail

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
libexec_dir="$bin_dir/../libexec/desktop"

usage() {
  cat <<'EOF'
Usage: desktop <lock|lock-preview|raise-or-launch|keybinds|swap-window|stack-window|rowresize|mirror-toggle|reconnect-trackpad>

Control desktop-level Hyprland/Quickshell surfaces.
EOF
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  lock) exec "$libexec_dir/lock" "$@" ;;
  lock-preview) exec "$libexec_dir/lock-preview" "$@" ;;
  raise-or-launch) exec "$libexec_dir/raise-or-launch" "$@" ;;
  keybinds) exec "$libexec_dir/keybinds" "$@" ;;
  swap-window) exec "$libexec_dir/swap-window" "$@" ;;
  stack-window) exec "$libexec_dir/stack-window" "$@" ;;
  rowresize) exec "$libexec_dir/rowresize" "$@" ;;
  mirror-toggle) exec "$libexec_dir/mirror-toggle" "$@" ;;
  reconnect-trackpad) exec "$libexec_dir/reconnect-trackpad" "$@" ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 1 ;;
esac
