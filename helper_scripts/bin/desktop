#!/usr/bin/env bash
set -euo pipefail

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
libexec_dir="$bin_dir/../libexec/desktop"

usage() {
  cat <<'EOF'
Usage: desktop <lock|lock-preview|raise-or-launch|keybinds|swap-window|stack-window|rowresize|mirror-toggle|reconnect-trackpad|text-expander|brightness-ddc|screenshot|notifications-privacy|notifications-dnd|notifications-history|notification-times-watcher|record|monitor-profile|monitor-profile-editor|nightlight|color-picker|capture-text|capture-qr>

Control desktop-level Hyprland/Quickshell surfaces.
EOF
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  lock) exec "$libexec_dir/lock" "$@" ;;
  lock-preview) exec "$libexec_dir/lock-preview" "$@" ;;
  raise-or-launch) exec "$libexec_dir/raise-or-launch" "$@" ;;
  keybinds) exec "$libexec_dir/keybinds" "$@" ;;
  swap-window) exec "$libexec_dir/swap-window" "$@" ;;
  stack-window) exec "$libexec_dir/stack-window" "$@" ;;
  rowresize) exec "$libexec_dir/rowresize" "$@" ;;
  mirror-toggle) exec "$libexec_dir/mirror-toggle" "$@" ;;
  reconnect-trackpad) exec "$libexec_dir/reconnect-trackpad" "$@" ;;
  text-expander) exec "$libexec_dir/text-expander" "$@" ;;
  brightness-ddc) exec "$libexec_dir/brightness-ddc" "$@" ;;
  screenshot) exec "$libexec_dir/screenshot" "$@" ;;
  notifications-privacy) exec "$libexec_dir/notifications-privacy" "$@" ;;
  notifications-dnd) exec "$libexec_dir/notifications-dnd" "$@" ;;
  notifications-history) exec "$libexec_dir/notifications-history" "$@" ;;
  notification-times-watcher) exec "$libexec_dir/notification-times-watcher" "$@" ;;
  record) exec "$libexec_dir/record" "$@" ;;
  monitor-profile) exec "$libexec_dir/monitor-profile" "$@" ;;
  monitor-profile-editor) exec "$libexec_dir/monitor-profile-editor" "$@" ;;
  nightlight) exec "$libexec_dir/nightlight" "$@" ;;
  color-picker) exec "$libexec_dir/color-picker" "$@" ;;
  capture-text) exec "$libexec_dir/capture-text" "$@" ;;
  capture-qr) exec "$libexec_dir/capture-qr" "$@" ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 1 ;;
esac
