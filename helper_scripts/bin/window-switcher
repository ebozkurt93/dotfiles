#!/usr/bin/env bash

set -euo pipefail

backend="--walker"

usage() {
  cat <<'EOF'
Usage: window-switcher [--walker|--list] [--demo]

Show Hyprland windows in a launcher UI and focus the selected window.
Use --demo to show richer synthetic rows for launcher/fuzzy comparison.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing command: $1" >&2
    exit 1
  }
}

demo=0
args=()
for arg in "$@"; do
  case "$arg" in
    --demo) demo=1 ;;
    *) args+=("$arg") ;;
  esac
done

if [ "${#args[@]}" -gt 0 ]; then
  backend="${args[0]}"
fi

window_rows_live() {
  require_cmd hyprctl
  require_cmd jq

  local clients_json
  clients_json="$(hyprctl clients -j 2>/dev/null || true)"

  if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$clients_json"; then
    exit 0
  fi

  jq -r '
    sort_by(.workspace.id, .class, .title)
    | .[]
    | select(.mapped == true)
    | [
        .address,
        (.class // "unknown" | gsub("[\t\n]"; " ")),
        (.title // "untitled" | gsub("[\t\n]"; " ")),
        ("workspace " + ((.workspace.name // (.workspace.id | tostring)) | tostring))
      ]
    | @tsv
  ' <<<"$clients_json"
}

window_rows_demo() {
  cat <<'EOF'
0xdemo0001	Firefox Developer Edition	GitHub - Walker launcher source	workspace 1 web github launcher
0xdemo0002	Firefox Developer Edition	Walker documentation - dmenu and providers	workspace 1 web docs launcher
0xdemo0003	Firefox Developer Edition	NixOS Search - walker package aarch64-linux	workspace 1 web nix packages
0xdemo0004	Firefox Developer Edition	Hyprland wiki - native Lua config examples	workspace 1 web hyprland lua
0xdemo0005	Firefox Developer Edition	Pull request: migrate hammerspoon window switcher	workspace 1 web review
0xdemo0006	Firefox Developer Edition	Linear - VM work machine migration tasks	workspace 1 web tasks
0xdemo0007	Firefox Developer Edition	Google Translate - Turkish to English	workspace 1 web translate
0xdemo0008	Firefox Developer Edition	Omarchy launcher setup notes	workspace 1 web omarchy
0xdemo0009	Ghostty	~/dotfiles - nvim hyprland/.config/hypr/hyprland.lua	workspace 2 terminal config
0xdemo0010	Ghostty	~/dotfiles - git diff packages.nix MIGRATION.md	workspace 2 terminal git
0xdemo0011	Ghostty	~/workspace/api - direnv exec . bun test	workspace 2 terminal tests
0xdemo0012	Ghostty	ssh nixos-vm - sudo nixos-rebuild switch	workspace 2 terminal vm
0xdemo0013	Ghostty	~/dotfiles - rg hammerspoon scoped_hotkeys	workspace 2 terminal search
0xdemo0014	Ghostty	~/notes - aider launcher spike notes	workspace 2 terminal notes
0xdemo0015	Obsidian	Migration plan - Hammerspoon to Hyprland	workspace 3 notes migration
0xdemo0016	Obsidian	Launcher ideas - actions tabs windows files	workspace 3 notes launcher
0xdemo0017	Obsidian	Work setup checklist - VM daily driver	workspace 3 notes work
0xdemo0018	Obsidian	Linux replacements for Raycast workflows	workspace 3 notes raycast
0xdemo0019	Slack	instabee-dev - incident thread	workspace 4 chat work
0xdemo0020	Slack	frontend-platform - PR review ping	workspace 4 chat review
0xdemo0021	Slack	dotfiles - launcher UI screenshots	workspace 4 chat design
0xdemo0022	Signal	Family - weekend plans	workspace 4 chat personal
0xdemo0023	Spotify	Now Playing - Nils Frahm radio	workspace 5 media music
0xdemo0024	VLC	Video - NixOS Hyprland screen recording	workspace 5 media video
0xdemo0025	FreeCAD	keyboard-case.FCStd - corne case revision	workspace 6 cad keyboard
0xdemo0026	OrcaSlicer	corne-bottom-plate.3mf - print settings	workspace 6 cad printing
0xdemo0027	Files	~/Downloads - Walker screenshots	workspace 6 files downloads
0xdemo0028	Files	~/personal-repositories/dotfiles-nixos	workspace 6 files dotfiles
0xdemo0029	Settings	Bluetooth - paired devices	workspace 6 settings bluetooth
0xdemo0030	Settings	Power - balanced profile	workspace 6 settings power
EOF

  local apps=(
    "Firefox Developer Edition"
    "Ghostty"
    "Obsidian"
    "Slack"
    "Signal"
    "Spotify"
    "VLC"
    "FreeCAD"
    "Files"
    "Settings"
    "Calendar"
    "Thunderbird"
    "Walker"
    "Quickshell"
    "Hyprland"
  )
  local topics=(
    "launcher fuzzy ranking"
    "window switcher prototype"
    "browser tab provider"
    "custom action registry"
    "weather widget quickshell"
    "keyboard battery corne"
    "state switcher backend"
    "bluetooth device picker"
    "power profile toggle"
    "nix flake check"
    "home manager activation"
    "firefox developer edition"
    "translation popup"
    "file browser provider"
    "calculator provider"
    "work machine vm"
  )
  local projects=(
    "dotfiles-nixos"
    "hammerspoon-port"
    "launcher-spike"
    "hyprland-config"
    "quickshell-bar"
    "state-switcher"
    "tmux-mover"
    "firefox-bridge"
  )
  local i app topic project workspace

  for i in $(seq 31 180); do
    app="${apps[$(((i - 31) % ${#apps[@]}))]}"
    topic="${topics[$(((i - 31) % ${#topics[@]}))]}"
    project="${projects[$(((i - 31) % ${#projects[@]}))]}"
    workspace=$((((i - 31) % 8) + 1))
    printf '0xdemo%04d\t%s\t%s - %s #%03d\tworkspace %s %s %s\n' \
      "$i" "$app" "$project" "$topic" "$i" "$workspace" "$project" "$topic"
  done
}

window_rows() {
  if [ "$demo" = 1 ]; then
    window_rows_demo
  else
    window_rows_live
  fi
}

display_rows() {
  window_rows | awk -F '\t' '{ print $2 " | " $3 " | " $4 "\t" $1 }'
}

focus_selected() {
  local selected="$1"
  local address

  [ -n "$selected" ] || exit 0
  address="${selected##*$'\t'}"

  if [[ "$address" != 0x* ]]; then
    echo "could not parse selected window address: $selected" >&2
    exit 1
  fi

  if [[ "$address" == 0xdemo* ]]; then
    echo "$selected"
    exit 0
  fi

  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$address" >/dev/null
}

case "$backend" in
  --list)
    display_rows
    ;;
  --walker)
    require_cmd walker
    selected="$(display_rows | walker --dmenu)"
    focus_selected "$selected"
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
