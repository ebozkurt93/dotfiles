#!/usr/bin/env bash

# Switches DNS for active NetworkManager connections (wifi/ethernet) between
# DHCP-provided servers, Cloudflare, Google, or a custom list.
#
# Unlike Omarchy's omarchy-dns, this only sets per-connection ipv4.dns/ipv6.dns
# via nmcli -- it doesn't touch /etc/systemd/resolved.conf or write a global
# NetworkManager DNS conf file. On NixOS /etc is normally a read-only symlink
# into the Nix store, so a raw `tee` into /etc/systemd/resolved.conf (what
# omarchy-dns does) doesn't persist there the way it does on Arch. The
# per-connection nmcli approach doesn't need root: users in the
# "networkmanager" group can modify their own connection profiles.

set -euo pipefail

CLOUDFLARE_V4="1.1.1.1,1.0.0.1"
CLOUDFLARE_V6="2606:4700:4700::1111,2606:4700:4700::1001"
GOOGLE_V4="8.8.8.8,8.8.4.4"
GOOGLE_V6="2001:4860:4860::8888,2001:4860:4860::8844"

usage() {
  echo "Usage: dns-manager current" >&2
  echo "       dns-manager set DHCP|Cloudflare|Google" >&2
  echo "       dns-manager set Custom <space-separated servers>" >&2
  exit 1
}

active_connections() {
  nmcli -t -f UUID,TYPE connection show --active 2>/dev/null \
    | awk -F: '$2 == "802-11-wireless" || $2 == "802-3-ethernet" {print $1}'
}

current() {
  local uuid dns
  uuid=$(active_connections | head -1)
  if [[ -z "$uuid" ]]; then
    echo "DHCP"
    return
  fi

  dns=$(nmcli -g ipv4.dns connection show "$uuid" 2>/dev/null || true)
  if [[ -z "$dns" ]]; then
    echo "DHCP"
  elif [[ "$dns" == *"1.1.1.1"* ]]; then
    echo "Cloudflare"
  elif [[ "$dns" == *"8.8.8.8"* ]]; then
    echo "Google"
  else
    echo "Custom"
  fi
}

reapply_connection() {
  local uuid="$1" device
  device=$(nmcli -g GENERAL.DEVICES connection show "$uuid" 2>/dev/null | head -1)
  [[ -n "$device" ]] && nmcli device reapply "$device" >/dev/null 2>&1 || true
}

set_provider() {
  local provider="$1" v4="" v6=""

  case "$provider" in
    DHCP) ;;
    Cloudflare) v4="$CLOUDFLARE_V4"; v6="$CLOUDFLARE_V6" ;;
    Google) v4="$GOOGLE_V4"; v6="$GOOGLE_V6" ;;
    Custom)
      v4=$(printf '%s' "${2:-}" | tr ' \t' ',,' | tr -s ',')
      [[ -n "$v4" ]] || { echo "Custom requires at least one DNS server" >&2; exit 1; }
      ;;
    *) usage ;;
  esac

  local found=false
  while read -r uuid; do
    [[ -z "$uuid" ]] && continue
    found=true
    if [[ "$provider" == "DHCP" ]]; then
      nmcli connection modify "$uuid" \
        ipv4.ignore-auto-dns no ipv4.dns "" \
        ipv6.ignore-auto-dns no ipv6.dns ""
    else
      nmcli connection modify "$uuid" \
        ipv4.ignore-auto-dns yes ipv4.dns "$v4" \
        ipv6.ignore-auto-dns yes ipv6.dns "$v6"
    fi
    reapply_connection "$uuid"
  done < <(active_connections)

  "$found" || { echo "No active wifi/ethernet connection to modify" >&2; exit 1; }
}

case "${1:-}" in
  current) current ;;
  set) shift; set_provider "$@" ;;
  *) usage ;;
esac
