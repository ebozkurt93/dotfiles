#!/usr/bin/env bash
set -euo pipefail

# Hyprland's scrolling layout has no "rowresize" layout message the way it
# has "colresize" for column width -- row height (a stacked window's share
# of its column) is only adjustable by mouse-dragging the border between
# two stacked windows. hl.dsp.window.resize({x, y}) sets an absolute size
# on the currently-focused window and, when it's part of a column stack,
# triggers the same internal row-height rebalancing the mouse drag does --
# but only ever against ONE neighbor, and Hyprland's own default (used
# whenever no drag corner is given, which a script call never gives) always
# prefers the neighbor *above* when one exists. Confirmed the `corner`
# dispatcher param does nothing here (accepted silently, no effect) -- this
# preference is hardcoded, not something a script can ask Hyprland to flip.
#
# That means resizing the focused window directly moves *its own* top edge
# whenever it has a window above it -- undesirable; the top edge should
# stay put and only the boundary with whatever's below should move. Worked
# around by redirecting the resize to the *next* (below) window instead
# when one exists: that window's own "prev" is the originally-focused one,
# so adjusting its size moves exactly the boundary we want and leaves the
# focused window's top edge untouched. Only the bottom-most window in a
# stack (no "next" to redirect to) falls back to resizing itself directly,
# which unavoidably moves its own top edge -- there's nothing below it to
# absorb the change instead.

fraction="${1:-}"
if [ -z "$fraction" ]; then
  echo "usage: desktop rowresize <+0.1|-0.1|...>" >&2
  exit 1
fi

active_json="$(hyprctl activewindow -j)"
active_addr="$(jq -r '.address // empty' <<<"$active_json")"
[ -z "$active_addr" ] && exit 0

active_x="$(jq -r '.at[0]' <<<"$active_json")"
active_y="$(jq -r '.at[1]' <<<"$active_json")"
active_w="$(jq -r '.size[0]' <<<"$active_json")"
active_h="$(jq -r '.size[1]' <<<"$active_json")"
active_mon="$(jq -r '.monitor' <<<"$active_json")"

clients="$(hyprctl clients -j)"

next_json="$(jq -c --arg addr "$active_addr" --argjson x "$active_x" --argjson y "$active_y" --argjson mon "$active_mon" '
  [.[] | select(.monitor == $mon and .floating == false and .at[0] == $x and .address != $addr and .at[1] > $y)]
  | sort_by(.at[1]) | .[0] // empty
' <<<"$clients")"

if [ -n "$next_json" ]; then
  next_addr="$(jq -r '.address' <<<"$next_json")"
  next_w="$(jq -r '.size[0]' <<<"$next_json")"
  next_h="$(jq -r '.size[1]' <<<"$next_json")"

  total_h=$((active_h + next_h))
  delta_px=$(awk -v total="$total_h" -v frac="$fraction" 'BEGIN { printf "%d", total * frac }')
  new_next_h=$((next_h - delta_px))

  min_h=$(awk -v total="$total_h" 'BEGIN { printf "%d", total * 0.1 }')
  max_h=$((total_h - min_h))
  [ "$new_next_h" -lt "$min_h" ] && new_next_h="$min_h"
  [ "$new_next_h" -gt "$max_h" ] && new_next_h="$max_h"

  # The focus->resize->refocus dance below briefly makes the neighbor the
  # active window, and Hyprland warps the cursor to match on every focus
  # change by default -- visible as the pointer jumping there and back.
  # Suppress that for just this operation rather than disabling it globally
  # (which would also affect real window-navigation focus changes). Reads
  # the user's actual current setting first: if they've already disabled
  # warps themselves, leave it alone entirely -- no toggle, no restore.
  no_warps_was="$(hyprctl getoption cursor:no_warps | awk '/^bool:/ { print $2 }')"
  if [ "$no_warps_was" = "false" ]; then
    hyprctl eval 'hl.config({ cursor = { no_warps = true } })' >/dev/null
    trap 'hyprctl eval "hl.config({ cursor = { no_warps = false } })" >/dev/null' EXIT
  fi

  hyprctl dispatch "hl.dsp.focus({ window = \"address:$next_addr\" })" >/dev/null
  hyprctl dispatch "hl.dsp.window.resize({ x = $next_w, y = $new_next_h })" >/dev/null
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$active_addr\" })" >/dev/null
  exit 0
fi

prev_h="$(jq -r --arg addr "$active_addr" --argjson x "$active_x" --argjson y "$active_y" --argjson mon "$active_mon" '
  [.[] | select(.monitor == $mon and .floating == false and .at[0] == $x and .address != $addr and .at[1] < $y)]
  | sort_by(-.at[1]) | .[0].size[1] // empty
' <<<"$clients")"

[ -z "$prev_h" ] && exit 0

total_h=$((active_h + prev_h))
delta_px=$(awk -v total="$total_h" -v frac="$fraction" 'BEGIN { printf "%d", total * frac }')
new_h=$((active_h + delta_px))

min_h=$(awk -v total="$total_h" 'BEGIN { printf "%d", total * 0.1 }')
max_h=$((total_h - min_h))
[ "$new_h" -lt "$min_h" ] && new_h="$min_h"
[ "$new_h" -gt "$max_h" ] && new_h="$max_h"

hyprctl dispatch "hl.dsp.window.resize({ x = $active_w, y = $new_h })" >/dev/null
