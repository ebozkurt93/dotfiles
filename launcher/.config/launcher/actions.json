  {
    "id": "action:screenshot-fullscreen",
    "kind": "tool",
    "icon": "applets-screenshooter",
    "title": "Screenshot: Fullscreen",
    "subtitle": "Capture the focused monitor",
    "keywords": ["screenshot", "capture", "fullscreen", "monitor"],
    "actions": [
      {"id": "run", "title": "Capture", "command": "~/bin/desktop screenshot fullscreen"}
    ]
  }
]
