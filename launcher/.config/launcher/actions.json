[
  {
    "id": "action:power-profile",
    "kind": "setting",
    "icon": "power",
    "title": "Toggle Power Profile",
    "subtitle": "Switch balanced <-> power-saver",
    "keywords": ["power", "battery", "profile", "low power", "energy"],
    "actions": [
      {"id": "run", "title": "Toggle", "command": "~/bin/helpers/low-power-mode-toggle.sh"},
      {"id": "copy", "title": "Copy Command", "command": "printf '%s' '~/bin/helpers/low-power-mode-toggle.sh' | wl-copy"}
    ]
  },
  {
    "id": "action:calculator",
    "kind": "tool",
    "icon": "accessories-calculator",
    "title": "Calculator",
    "subtitle": "Open qalc",
    "keywords": ["calculator", "calc", "qalc", "math", "convert"],
    "actions": [
      {"id": "open", "title": "Open Calculator", "command": "ghostty -e qalc"}
    ]
  },
  {
    "id": "system:lock",
    "kind": "system",
    "icon": "system-lock-screen",
    "title": "Lock",
    "subtitle": "Lock the current session",
    "keywords": ["lock", "screen", "session", "secure", "quickshell"],
    "actions": [
      {"id": "lock", "title": "Lock", "command": "~/bin/desktop lock"}
    ]
  },
  {
    "id": "dev:lock-preview",
    "kind": "tool",
    "icon": "system-lock-screen",
    "title": "Lock Screen Preview",
    "subtitle": "Show the lock UI without locking",
    "keywords": ["lock", "screen", "preview", "theme", "style"],
    "actions": [
      {"id": "preview", "title": "Preview", "command": "~/bin/desktop lock-preview"}
    ]
  },
  {
    "id": "system:restart-quickshell",
    "kind": "script",
    "icon": "view-refresh",
    "title": "Restart Quickshell",
    "subtitle": "Reload the shell UI",
    "keywords": ["quickshell", "shell", "restart", "reload", "bar", "launcher"],
    "actions": [
      {"id": "restart", "title": "Restart", "command": "pkill quickshell; quickshell >/tmp/quickshell.log 2>&1 &"}
    ]
  },
  {
    "id": "system:exit-hyprland",
    "kind": "system",
    "icon": "system-log-out",
    "title": "Exit Hyprland",
    "subtitle": "Log out of the current session",
    "keywords": ["exit", "logout", "log out", "quit", "session", "hyprland"],
    "actions": [
      {"id": "confirm", "title": "Yes, exit and log out", "command": "hyprctl dispatch 'hl.dsp.exit()'"},
      {"id": "cancel", "title": "Cancel", "command": "true"}
    ]
  },
  {
    "id": "system:reload-hyprland",
    "kind": "script",
    "icon": "view-refresh",
    "title": "Reload Hyprland",
    "subtitle": "Apply the current Hyprland config",
    "keywords": ["hyprland", "reload", "wm", "window manager", "config"],
    "actions": [
      {"id": "reload", "title": "Reload", "command": "hyprctl reload"}
    ]
  },
  {
    "id": "action:reset-wifi-dns",
    "kind": "setting",
    "icon": "network-wireless",
    "title": "Reset WiFi DNS",
    "subtitle": "Restore DHCP-provided DNS servers",
    "keywords": ["dns", "wifi", "network", "reset", "dhcp"],
    "actions": [
      {"id": "run", "title": "Reset to DHCP", "command": "~/bin/dns-manager set DHCP"}
    ]
  },
  {
    "id": "action:reconnect-trackpad",
    "kind": "setting",
    "icon": "input-touchpad",
    "title": "Reconnect Trackpad",
    "subtitle": "Cycle Bluetooth pairing for the flaky trackpad",
    "keywords": ["trackpad", "bluetooth", "reconnect", "pair"],
    "actions": [
      {"id": "run", "title": "Reconnect", "command": "~/bin/desktop reconnect-trackpad"}
    ]
  },
  {
    "id": "action:mirror-toggle",
    "kind": "setting",
    "icon": "video-display",
    "title": "Toggle Display Mirroring",
    "subtitle": "Mirror internal display to external monitor",
    "keywords": ["mirror", "display", "monitor", "external", "screen"],
    "actions": [
      {"id": "run", "title": "Toggle", "command": "~/bin/desktop mirror-toggle"}
    ]
  },
  {
    "id": "action:notifications-privacy",
    "kind": "setting",
    "icon": "notification-symbolic",
    "title": "Toggle Notification Privacy",
    "subtitle": "Hide notification toasts from screen shares/recordings",
    "keywords": ["notifications", "privacy", "screen share", "recording", "hide", "dnd"],
    "actions": [
      {"id": "run", "title": "Toggle", "command": "~/bin/desktop notifications-privacy toggle"}
    ]
  },
  {
    "id": "action:screenshot-region",
    "kind": "tool",
